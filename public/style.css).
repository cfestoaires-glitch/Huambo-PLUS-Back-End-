:root {
    --primary: #0066cc;
    --primary-hover: #0052a3;
    --accent: #ff9900;
    --bg-main: #f4f6f9;
    --bg-card: #ffffff;
    --text-main: #333333;
    --text-muted: #666666;
    --border: #e0e0e0;
    --shadow: 0 4px 12px rgba(0,0,0,0.08);
}

[data-theme="dark"] {
    --primary: #3385ff;
    --primary-hover: #1a75ff;
    --accent: #ffa61a;
    --bg-main: #121212;
    --bg-card: #1e1e1e;
    --text-main: #e0e0e0;
    --text-muted: #aaaaaa;
    --border: #333333;
    --shadow: 0 4px 12px rgba(0,0,0,0.4);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-main);
    color: var(--text-main);
    transition: background-color 0.3s, color 0.3s;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
.header-main {
    background-color: var(--bg-card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px;
}

.logo {
    font-size: 1.5rem;
    color: var(--primary);
}

.logo span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    gap: 10px;
}

.nav-btn {
    background: none;
    border: none;
    padding: 10px 16px;
    color: var(--text-main);
    cursor: pointer;
    border-radius: 6px;
    font-weight: 500;
    transition: background-color 0.2s;
}

.nav-btn:hover, .nav-btn.active {
    background-color: var(--primary);
    color: #ffffff;
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Botões Globais */
.btn-primary {
    background-color: var(--primary);
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.btn-accent {
    background-color: var(--accent);
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
}

.btn-block {
    width: 100%;
}

/* Busca e Filtros */
.search-bar-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 12px;
    margin: 24px 0;
}

.input-group {
    position: relative;
    display: flex;
    align-items: center;
}

.input-group input, .input-group select, .form-group input, .form-group select {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--bg-card);
    color: var(--text-main);
}

/* Alternador de Visualização */
.view-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.view-toggle button {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
}

.view-toggle button.active {
    background-color: var(--primary);
    color: #fff;
}

/* Grelha de Cards */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    box-shadow: var(--shadow);
}

.card h3 {
    margin-bottom: 8px;
    color: var(--primary);
}

.card-badge {
    display: inline-block;
    background-color: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    padding: 4px 8px;
    border-radius: 12px;
    margin-bottom: 12px;
}

/* Conteúdo das Abas */
.tab-content {
    display: none;
    padding: 20px 0;
}

.tab-content.active {
    display: block;
}

/* Mapa */
.map-hidden {
    display: none;
}

#map {
    height: 500px;
    width: 100%;
    border-radius: 8px;
}

/* Formulário de Registo */
.form-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    max-width: 700px;
    margin: 0 auto;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

/* Modais */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    justify-content: center;
    align-items: center;
    z-index: 2000;
}

.modal-content {
    background-color: var(--bg-card);
    padding: 30px;
    border-radius: 8px;
    width: 100%;
    max-width: 400px;
    position: relative;
}

.close-modal {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 1.5rem;
    cursor: pointer;
}
